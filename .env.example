# Multi-project mode (recommended): host dir whose DIRECT subdirs are
# projects (one git repo each). Folder name = project name; the list is
# scanned automatically, current project is chosen via /projects in telegram.
# Default ./projects already works: just drop project folders into
# <compose dir>/projects/ and multi mode activates itself.
# PROJECTS_DIR=./projects

# Single-project mode (used only when PROJECTS_DIR is not set):
# path to the project dir. If empty, the container clones GIT_REPO_URL.
PROJECT_DIR=/srv/my-project

# Repo to clone when PROJECT_DIR is empty.
# SSH (needs the ~/.ssh mount):    git@github.com:kilopers/my-project.git
# HTTPS token (no ssh needed):     https://x-access-token:ghp_xxx@github.com/kilopers/my-project.git
GIT_REPO_URL=git@github.com:kilopers/my-project.git
# GIT_BRANCH=main

# Model: swe, opus, sonnet, gpt, ...  (see `devin models list`)
# Telegram /model, /models и селект в вебе перекрывают это (таблица kv).
DEVIN_MODEL=swe

# Session mode: false = every task is a fresh session (default);
# true = resume the selected project's last session when it exists.
# Telegram /session overrides at runtime (kv.session_mode).
# DEVIN_CONTINUE=false

# Git identity for commits made by the agent
GIT_USER_NAME=devin-bot
GIT_USER_EMAIL=devin-bot@killop.ru

# false = the agent does NOT commit/push; after each task telegram asks
# with buttons "Закоммитить и запушить" / "Пропустить". Default: true.
# GIT_AUTO_COMMIT=false

# Poll interval in seconds
POLL_INTERVAL=30

# Optional Telegram bot inside the same container (leave token empty to disable)
# TELEGRAM_BOT_TOKEN=123456:AAA...
# CHAT_ID=123456789          # numeric id; or send /start to the bot and it self-detects by TG_USERNAME
# TG_USERNAME=kiloper
# MESSAGE_TEXT=привет
# INTERVAL=60                 # 0 = send once at container start, then stay quiet

# Telegram webhook mode: voice messages get transcribed via Gemini and become
# tasks; the reply goes back to the chat. Any POST path on WEB_PORT is a webhook.
# TELEGRAM_WEBHOOK_URL=https://build.kilop.ru/
# TELEGRAM_WEBHOOK_SECRET=random-secret-string     # optional, verified via header
# GEMINI_API_KEY=AIza...                            # required for voice transcription
# GEMINI_MODEL=gemini-2.5-flash

# Alternative STT provider — OpenAI-compatible /audio/transcriptions.
# Groq (free whisper):   STT_PROVIDER=openai
#                        STT_BASE_URL=https://api.groq.com/openai/v1
#                        STT_API_KEY=gsk_...   STT_MODEL=whisper-large-v3-turbo
# OpenAI:                STT_PROVIDER=openai  STT_API_KEY=sk-...  STT_MODEL=whisper-1
# STT_PROVIDER=gemini
# STT_API_KEY=
# STT_BASE_URL=https://api.openai.com/v1
# STT_MODEL=whisper-1
# Fallback chain: STT_PROVIDER accepts comma-separated providers tried in
# order — e.g. STT_PROVIDER=gemini,openai (a denied Gemini key falls back
# to Groq/OpenAI). yandex and openai share STT_API_KEY.

# Yandex SpeechKit (works without foreign APIs):
#   STT_PROVIDER=yandex
#   STT_API_KEY=AQVN...                    # API key of a service account
#   YANDEX_FOLDER_ID=b1g...                # optional
#   YANDEX_LANG=ru-RU

# Встроенный прокси (mihomo, Clash Meta): положи mihomo/config.yaml рядом с
# compose-файлом (шаблон — mihomo.example.yaml) — watcher поднимет mihomo
# и направит devin API и telegram на http://127.0.0.1:7890 автоматически.
#
# Внешний прокси вместо mihomo — задай явно (имеет приоритет):
# HTTP_PROXY=http://user:password@proxy.company.local:3128
# HTTPS_PROXY=http://user:password@proxy.company.local:3128
# NO_PROXY=localhost,127.0.0.1
# Пусто + без mihomo/config.yaml = прямые соединения. Git всегда напрямую.

# MySQL — очередь/история задач и всё состояние воркера (проект, модель,
# режимы, pending-подтверждения, кэш моделей). Сервис mysql из compose
# поднимается сам; пароль задай свой. Чужой сервер: MYSQL_HOST/MYSQL_PORT.
MYSQL_PASSWORD=change-me
# MYSQL_HOST=mysql
# MYSQL_USER=devin
# MYSQL_DATABASE=devin_worker

# Status web page port on the host (container listens on 8080)
# WEB_PORT=80

# Web UI auth (один админ-аккаунт). Пароль сидится в MySQL (kv) при первом
# запуске и дальше меняется в профиле веб-морды — env после этого не действует.
# Сбросить: удали kv-ключ admin_password_hash и перезапусти с новым паролем.
# Пустой WEB_ADMIN_PASSWORD = веб без авторизации (только для dev).
# WEB_ADMIN_USER=admin
# WEB_ADMIN_PASSWORD=secret
# WEB_SESSION_SECRET=            # иначе генерируется и хранится в kv
